cat > .gitignore <<'EOF'
# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.env
.venv/
venv/
env/

# OS files
.DS_Store
Thumbs.db

# Logs and cache
*.log
.cache/

# Downloaded datasets
data/
../data/

# Generated outputs
outputs/

# Model checkpoints
checkpoints/
*.pt
*.pth

# ZIP files
*.zip
EOF